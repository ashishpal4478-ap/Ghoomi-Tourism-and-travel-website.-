# ==============================================================================
# GHOOMI BACKEND ENVIRONMENT VARIABLES (.env.example)
# Copy this file to .env or export these in your runtime environment.
# ==============================================================================

# Server Configuration
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=local

# Database Configuration (MySQL 8.4 LTS)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=ghoomi_dev
DB_USERNAME=root
DB_PASSWORD=your_mysql_password_here

# Full Spring Datasource URL override (optional)
# SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/ghoomi_dev?useSSL=false&allowPublicKeyRetrieval=true&connectionTimeZone=UTC&forceConnectionTimeZoneToSession=true&characterEncoding=UTF-8

# Flyway Migration Toggle
SPRING_FLYWAY_ENABLED=true

# Security & CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Google OAuth 2.0 Credentials
# Obtain these from Google Cloud Console -> APIs & Services -> Credentials
# Authorized redirect URI in Google Console: http://localhost:8080/login/oauth2/code/google
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
OAUTH2_REDIRECT_URI=http://localhost:3000/login

# ==============================================================================
# SMTP Mail Delivery Configuration (Password Recovery & Notifications)
# Configure with your SMTP provider (e.g. Gmail App Password, AWS SES, SendGrid).
# ==============================================================================
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@example.com
MAIL_PASSWORD=your-secure-app-password
MAIL_FROM=noreply@ghoomi.com
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true



